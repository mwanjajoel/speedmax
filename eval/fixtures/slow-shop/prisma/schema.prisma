generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id     String  @id @default(cuid())
  email  String  @unique
  name   String
  orders Order[]
}

model Order {
  id         String   @id @default(cuid())
  userId     String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  status     String
  total      Int
  createdAt  DateTime @default(now())
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique
}
